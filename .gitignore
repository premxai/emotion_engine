*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# PyTorch checkpoints — ignore generated ones, but keep released checkpoints
*.pth
*.ckpt
outputs/**/*.pt
outputs/**/*.pth

# Allow committed checkpoints
!checkpoints/**/*.pt

# Simulation outputs (generated — not committed)
outputs/

# Django secrets and local config
environment/frontend_server/frontend_server/settings/local.py
environment/frontend_server/db.sqlite3
environment/frontend_server/storage/
environment/frontend_server/compressed_storage/
environment/frontend_server/temp_storage/
environment/frontend_server/*.log

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

